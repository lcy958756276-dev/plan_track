<?xml version="1.0"?>
<package format="2">
  <name>double_nmpc_controller</name>
  <version>0.1.0</version>
  <description>Two-layer nonlinear predictive local controller with tracking-margin feedback.</description>
  <maintainer email="maintainer@example.com">plan_track</maintainer>
  <license>GPL-3.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>costmap_2d</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_core</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>base_local_planner</depend>
  <depend>controller</depend>

  <export>
    <nav_core plugin="${prefix}/double_nmpc_controller_plugin.xml" />
  </export>
</package>
